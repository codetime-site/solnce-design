// === ОСНОВНЫЕ СТИЛИ ХЕДЕРА ===
header
    background linear-gradient(116deg, #0a0a0a, #574646ab, #000000c9)
    position fixed
    top 0
    left 0
    z-index 100
    width 100%

.header__content
    display flex
    column-gap 47px
    justify-content center
    align-items center
    padding 16px

.header__mobile
    display none

// === ЛОГО ===
.header__logo
    text-align center

.header__logo p
    text-align center
    font-size .7em

svg#logo
    width 208px
    height auto

// === МЕНЮ ===
.header__menu .menu__list
    display flex
    gap 4px
    align-items center
    padding 12px 8px

.header__menu .menu-item
    transition all .2s
    padding 5px 20px

.header__menu .menu-item:hover
.header__menu .current-menu-item
    background #fe4f18
    border-radius 5px

// === ПРАВАЯ ЧАСТЬ (CALLME) ===
.header__callme
    display flex
    align-items center
    gap 12px

.header__callme .btn
    border-radius 5px
    padding 8px 10px

.callme__right
    width 166px

.callme__right > a
    display block


// === МОБИЛЬНЫЕ СТИЛИ ===
+below(t)
    .header__content
        flex-direction column
        align-items flex-start
        padding 10px 15px

    .header__logo
        width 100%
        display flex
        flex-direction column
        align-items center

    svg#logo
        width 150px

    .header__logo p
        font-size .8em
        margin-top 5px

    .header__menu
        width 100%
        position relative

    .header__menu .menu__list
        display none
        flex-direction column
        position absolute
        top 100%
        left 0
        width 100%
        background #0a0a0a
        padding 10px 0
        box-shadow 0 2px 5px rgba(0, 0, 0, .5)

    .header__menu .menu__list.active
        display flex

    .header__menu .menu-item
        padding 10px 15px
        text-align center

    .header__menu .menu-item:hover
        background #fe4f18

    .header__callme
        width 100%
        justify-content center
        margin-top 10px

    .callme__right
        width auto
        text-align center

    .callme__right > a
        font-size .9em

    // Гамбургер
    .header__mobile
        display flex
        align-items center
        justify-content flex-end
        width 100%
        padding 10px 15px

    .hamburger
        display block
        width 30px
        height 20px
        position relative
        cursor pointer

    .hamburger span
        display block
        height 3px
        background #fff
        margin-bottom 5px
        transition all .3s

    .hamburger.active span:nth-child(1)
        transform rotate(45deg) translate(5px, 5px)

    .hamburger.active span:nth-child(2)
        opacity 0

    .hamburger.active span:nth-child(3)
        transform rotate(-45deg) translate(7px, -7px)