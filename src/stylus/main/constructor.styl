canvas
    // border 1px solid #ccc
    border-radius 8px
    display block
    margin-top 10px
    object-fit contain

canvas#c 
    position: absolute;
    width: 900px;
    height: 600px;
    left: 0px;
    top: 0px;
    touch-action: none;
    user-select: none;

#buttons,
#elements,
#ceilings
    margin-bottom 10px
    display flex
    flex-wrap wrap
    gap 8px
    justify-content: center

#ceilings button
    background: transparent;

#buttons button
    padding 8px 12px
    border none
    border-radius 6px
    cursor pointer
    background clr(sun);
    color white
    transition background 0.2s

#buttons button.active
    background #10b981

#buttons button.save
    background #f59e0b

#buttons button.reset
    background #ef4444

#elements button
    width 70px
    height 70px
    border none
    border-radius 10px
    background-color transparent
    background-size cover
    background-position center
    cursor pointer
    box-shadow 0 0 5px rgba(0, 0, 0, 0.2)
    transition transform 0.2s, box-shadow 0.2s

#elements button:hover
    transform scale(1.1)
    box-shadow 0 0 10px rgba(0, 0, 0, 0.4)

#elements button.active
    outline 3px solid #0078ff

#ceilings
    gap 10px 
    justify-content center

#ceilings button
    width 80px
    height 80px
    border none
    border-radius 10px
    background-size cover
    background-position center
    box-shadow 0 0 5px rgba(0, 0, 0, 0.3)
    cursor pointer
    transition transform 0.2s

#ceilings button:hover
    transform scale(1.1)

#ceilings button.active
    outline 3px solid #00bfff

.canvas-container 
    margin: auto;


// ======== MOBILE ADAPTIVE ========
// Для экранов меньше 768px
@media (max-width: 768px)
    canvas#c 
        width 100% !important
        height auto !important
        
    .container
        width 100%
        padding 10px
        box-sizing border-box

    h2
        font-size 18px
        text-align center
        margin-bottom 12px

    #buttons
        flex-direction column
        align-items center
        gap 6px

    #buttons button
        width 100%
        max-width 250px
        font-size 14px
        padding 10px 0
        border-radius 10px

    #ceilings,
    #elements
        justify-content center
        gap 6px
        margin-bottom 12px

    #ceilings button,
    #elements button
        width 60px
        height 60px
        border-radius 8px
        box-shadow 0 0 3px rgba(0,0,0,0.25)
        background-size cover
        background-position center

    #elements button:hover,
    #ceilings button:hover
        transform none
        box-shadow 0 0 5px rgba(0,0,0,0.3)

    canvas
        width 100%
        height auto
        max-height 400px
        border-radius 8px
        object-fit contain
        margin-top 10px

// ======== EXTRA SMALL PHONES ========
// Для очень маленьких экранов (до 480px)
@media (max-width: 480px)

    canvas
    .canvas-container
        width 100%; !important
    h2
        font-size 16px

    #buttons button
        font-size 13px
        padding 8px 0

    #elements button,
    #ceilings button
        width 50px
        height 50px

    canvas
        max-height 300px
